POSTGRES_DB=smart_queue
POSTGRES_USER=smart_queue
POSTGRES_PASSWORD=change-me
DB_URL=postgresql+psycopg://smart_queue:change-me@postgres:5432/smart_queue
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost
VITE_API_BASE_URL=http://localhost/api
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Только для публичного HTTPS-деплоя; замените перед выпуском сертификата.
DOMAIN=queue.example.edu
LETSENCRYPT_EMAIL=admin@example.edu

# Для демонстрации по LAN замените 192.168.1.10 на IP машины с Docker:
# CORS_ORIGINS=http://192.168.1.10
# VITE_API_BASE_URL=http://192.168.1.10/api
# PUBLIC_BASE_URL=http://192.168.1.10
